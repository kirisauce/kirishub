# Maintainer: kirisauce <kirisauce@qq.com>

pkgname=mnemon-bin
pkgver=0.2.2
pkgrel=1
pkgdesc="LLM-supervised persistent memory for AI agents - graph-based recall, cross-session knowledge, single binary (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/mnemon-dev/mnemon"
license=('Apache-2.0')
depends=()
provides=('mnemon')
conflicts=('mnemon' 'mnemon-git')
source_x86_64=("https://github.com/mnemon-dev/mnemon/releases/download/v${pkgver}/mnemon_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/mnemon-dev/mnemon/releases/download/v${pkgver}/mnemon_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('24b904f1dae193bbf44518dcbd46f669a1a58c6f735a4a53bffc0e67e642b832')
sha256sums_aarch64=('d07367a257128ca51b5e1dc067354d977f5f260e01f45f6f4a87d5231fc8b3ad')

package() {
  cd "$srcdir"
  install -Dm755 mnemon "$pkgdir/usr/bin/mnemon"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
